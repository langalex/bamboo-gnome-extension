{
  "name": "bamboo-timesheet",
  "version": "0.1.0",
  "private": true,
  "description": "GNOME Shell 51 extension showing BambooHR clock-in status and today's time entries",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs --release && node package.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gjs": "gjs test-status.js",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@girs/adw-1": "^5.6.0",
    "@girs/gio-2.0": "^5.6.0",
    "@girs/gjs": "^5.6.0",
    "@girs/glib-2.0": "^5.6.0",
    "@girs/gnome-shell": "^51.0.1",
    "@girs/gtk-4.0": "^5.6.0",
    "@girs/secret-1": "^5.6.0",
    "@girs/soup-3.0": "^5.6.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
