{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "gi://*": ["./node_modules/@girs/*/index.d.ts"],
      "resource:///org/gnome/shell/extensions/*": [
        "./node_modules/@girs/gnome-shell/dist/extensions/*",
      ],
    },
  },
  "include": ["src/**/*.ts"],
}
